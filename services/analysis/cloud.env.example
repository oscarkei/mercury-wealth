# Set these as private runtime secrets on the analysis host; never commit values.
DEEPSEEK_API_KEY=
MERCURY_SERVICE_TOKEN=
# Persistent private volume, writable by UID 10001.
MERCURY_CLOUD_DATA_DIR=/data
MERCURY_DAILY_JOB_LIMIT=100
# Optional existing provider keys, not required for unkeyed sources.
EIA_API_KEY=
BEA_API_KEY=
