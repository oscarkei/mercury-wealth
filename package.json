  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test:connected": "playwright test -c playwright.connected.config.ts",
    "prebuild": "node scripts/sync-wealth-skills.mjs",
    "pretest": "node scripts/sync-wealth-skills.mjs",
    "analysis:start": "node --env-file-if-exists=.env.local services/analysis/server.mjs",
    "analysis:test": "node --test services/analysis/tests/*.test.mjs",
    "start:mobile": "next start --hostname 127.0.0.1 --port 3001"
  },
  "dependencies": {
    "@json-render/core": "0.21.3",
    "@json-render/react": "0.21.3",
    "@tailwindcss/cli": "^4.3.3",
